rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isNotBanned() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'banned';
    }

    // ── Users ─────────────────────────────────────────────────
    // Cualquier usuario autenticado puede ver perfiles (información pública)
    // Solo el propio usuario o un admin puede escribir.
    // El campo 'phone' NO puede ser modificado directamente por el usuario:
    // debe pasar por el flujo de solicitud aprobada por un admin.
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isAdmin() ||
        (isOwner(userId) && (
          // El dueño NUNCA puede modificar su propio rol (previene escalada de privilegios)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          // El campo 'phone' solo se puede modificar si estaba vacío; si no, va por solicitud aprobada por admin
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) ||
            resource.data.get('phone', '') == ''
          )
        ));
      allow delete: if isAdmin();
    }

    // ── Phone change requests ─────────────────────────────────
    // Solo el propio usuario puede ver sus solicitudes; admins ven todas.
    // La creación se hace desde el cliente (autenticado); la resolución vía Admin SDK.
    match /phoneChangeRequests/{reqId} {
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Products ──────────────────────────────────────────────
    // Lectura pública (la vitrina es visible sin login)
    match /products/{productId} {
      allow read:   if true;
      // Solo usuarios no baneados pueden publicar
      allow create: if isNotBanned();
      // El dueño puede editar su producto pero NO puede poner status='blocked'
      // (eso es exclusivo de admins vía API). Los admins pueden hacer cualquier cambio.
      allow update: if isAuth() && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.status != 'blocked') ||
        isAdmin()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
    }

    // ── Proposals ─────────────────────────────────────────────
    // Toda escritura (create / update / delete) va exclusivamente vía Admin SDK:
    //   create  → /api/submit-proposal
    //   update  → /api/accept-proposal  o  /api/decline-proposal
    // El cliente nunca escribe propuestas directamente.
    match /proposals/{proposalId} {
      allow read:   if isAuth() && (
        resource.data.proposerUid      == request.auth.uid ||
        resource.data.productOwnerUid  == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // Solo Admin SDK via /api/submit-proposal
      allow update: if false; // Solo Admin SDK via /api/accept-proposal o /api/decline-proposal
      allow delete: if isAdmin();
    }

    // ── Matches (chats) ───────────────────────────────────────
    // Solo el dueño del producto puede crear un match (al aceptar propuesta)
    match /matches/{matchId} {
      allow read:   if isAuth() && (
        resource.data.ownerId     == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        isAdmin()
      );
      // Solo Admin SDK puede crear matches (flujo de acceptProposal vía /api/accept-proposal)
      allow create: if false;
      allow update: if isAuth() && (
        resource.data.ownerId     == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Mensajes del chat — solo los participantes del match
      match /messages/{messageId} {
        allow read, write: if isAuth() && (
          get(/databases/$(database)/documents/matches/$(matchId)).data.ownerId     == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.requesterId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── Ratings ───────────────────────────────────────────────
    // Solo lectura para autenticados. Solo Admin SDK puede escribir.
    match /ratings/{ratingId} {
      allow read:  if isAuth();
      allow write: if false; // Solo vía /api/rate-user con Admin SDK
    }

    // ── Notifications ─────────────────────────────────────────
    // Solo el destinatario puede leer/actualizar/borrar sus propias notificaciones.
    // Creación desde el cliente solo para tipos legítimos y para OTROS usuarios (MED-3):
    //   - 'new_message'    → AppContext.notifyMessage (chat)
    //   - 'support_ticket' → Truki.createTicket (notifica admins)
    // Todo lo demás (proposal_received, trade_completed, etc.) va por Admin SDK.
    match /notifications/{userId}/items/{notifId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create:       if isAuth()
                          && request.auth.uid != userId
                          && request.resource.data.type in ['new_message', 'support_ticket']
                          && request.resource.data.read  == false
                          && request.resource.data.keys().hasAll(['type', 'read', 'createdAt']);
      allow delete:       if isOwner(userId) || isAdmin();
    }

    // ── Support tickets ───────────────────────────────────────
    match /support/{ticketId} {
      allow create: if isAuth();
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      // El usuario puede actualizar su ticket, pero NO puede cambiar status ni adminId (MED-5).
      // Esos campos solo los modifica el Admin SDK (cuando el admin responde o cierra el ticket).
      allow update: if isAdmin() ||
        (isAuth() && resource.data.uid == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'adminId']));
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read:   if isAdmin() ||
          (isAuth() && get(/databases/$(database)/documents/support/$(ticketId)).data.uid == request.auth.uid);
        allow create: if isAdmin() ||
          (isAuth() && get(/databases/$(database)/documents/support/$(ticketId)).data.uid == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // ── User reports ──────────────────────────────────────────
    match /userReports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ── Reports (product reports) ─────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ── Proposal locks ────────────────────────────────────────
    // Solo el Admin SDK (servidor) puede leer, escribir y eliminar estos documentos.
    match /proposal_locks/{lockId} {
      allow read, write: if false;
    }

    // ── Rate limits (internal) ────────────────────────────────
    // Colección interna usada por el servidor para rate limiting distribuido.
    // Ningún cliente puede leer ni escribir directamente.
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }

    // ── Password resets ───────────────────────────────────────
    match /passwordResets/{token} {
      allow read, write: if false; // Solo Admin SDK
    }

    // ── Settings (stats públicas) ─────────────────────────────
    // Lectura pública para mostrar estadísticas en el landing.
    // Solo admins (vía Admin SDK o Firebase Console) pueden escribir.
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

  }
}
