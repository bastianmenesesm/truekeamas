# ═══════════════════════════════════════════════════════════════════════════════
# TRUEKEAMAS — Variables de entorno requeridas
# Copia este archivo como .env.local para desarrollo local.
# En producción (Vercel), configura estas variables en:
#   Project Settings → Environment Variables
#
# ⚠️  NUNCA subas .env.local ni .env al repositorio Git.
# ═══════════════════════════════════════════════════════════════════════════════


# ── URL base ────────────────────────────────────────────────────────────────
# URL pública del sitio. En desarrollo: http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://truekeamas.cl


# ── Firebase Admin SDK (servidor — SECRETAS) ─────────────────────────────────
# Obtenlas en: Firebase Console → Project Settings → Service Accounts
# → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=tu-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com
# La private key va entre comillas y con \n literal (no saltos de línea reales)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"


# ── Firebase App Check + reCAPTCHA v3 ────────────────────────────────────────
# Site Key: Google Cloud Console → reCAPTCHA Enterprise → Manage sites
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc...

# Solo para desarrollo local (no enviar a producción)
# Obtén el token en la consola del navegador al cargar la app con App Check en modo debug
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=


# ── Firebase Cloud Messaging — Push Notifications ────────────────────────────
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# → Generate key pair → copia la clave pública
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BJ...


# ── Brevo (Email transaccional — reset de contraseña) ────────────────────────
# Panel Brevo → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@truekeamas.cl
BREVO_SENDER_NAME=Truekeamas


# ── Google Analytics GA4 (opcional) ──────────────────────────────────────────
# Si no configuras esta variable, Analytics simplemente no se carga.
# Google Analytics → Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
